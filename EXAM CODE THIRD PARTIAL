#include "main.h"
#include "gpio.h" 

int nivel = 8;
int bomba_prendida = 0;

int display_numeros[9] = 
{
    0b00111111,
    0b00000110,
    0b01011011,
    0b01001111,
    0b01100110,
    0b01101101,
    0b01111101,
    0b00000111,
    0b01111111
};

void mostrar_display(int nivel_agua) 
{
    if (nivel_agua >= 0 && nivel_agua <= 8) 
    {

        GPIO_Write(GPIOC, display_numeros[nivel_agua]);
    }
}

void checar_niveles() 
{
    if (nivel > 3)
     {
        GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_SET);
    } 
    else 
    {
        GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_RESET);
    }
    
    if (nivel < 2) 
    {
        GPIO_WritePin(GPIOB, GPIO_PIN_2, GPIO_PIN_SET);
    } else 
    {
        GPIO_WritePin(GPIOB, GPIO_PIN_2, GPIO_PIN_RESET);
    }
    
    if (bomba_prendida == 1 && (nivel == 0 || nivel == 1))
     {
        bomba_prendida = 0; 
        GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_RESET);
    }
    
    if (bomba_prendida == 1) 
    {
        GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
    } else 
    {
        GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
    }
    
    mostrar_display(nivel);
}

int main() 
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    
    int boton_encender, boton_apagar;
    
    while(1) 
    {
        
        static int contador = 0;
        contador++;
        if (contador >= 500) 
        { 
            contador = 0;
            nivel--;
            if (nivel < 0) 
            {
                nivel = 8; 
            }
        }
        
        boton_encender = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_1);
        
        boton_apagar = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2);
        
        if (boton_encender == 1 && nivel > 3 && bomba_prendida == 0)
         {
            HAL_Delay(50);
            if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_1) == 1)
             {
                bomba_prendida = 1;
                GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_SET);
            }
        }
        
        if (boton_apagar == 1 && bomba_prendida == 1) 
        {
            HAL_Delay(50);
            if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2) == 1) 
            {
                bomba_prendida = 0;
                GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_RESET);
            }
        }
        
        checar_niveles();
        
        HAL_Delay(100);
    }
}
